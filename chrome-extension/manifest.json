{
  "manifest_version": 3,
  "name": "Job Posting Information Extractor",
  "version": "1.0",
  "description": "Extracts job posting information from the current webpage.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://*.icims.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.icims.com/*"],
      "js": ["job-sites/icims.js"]
    }
  ],
  "action": {
    "default_title": "Extract Job Information",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}